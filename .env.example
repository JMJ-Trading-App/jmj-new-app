# API base (include /v1). Used by Metro and baked into EAS builds via app.config extra.
# Production (default for device / EAS builds):
EXPO_PUBLIC_API_URL=https://api.jmj.finance/v1

# Local Nest overrides (uncomment one, comment production above):
# Physical device on same Wi‑Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/v1
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/v1
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000/v1
#
# After changing this file: npx expo start -c

# EAS project UUID (required for Expo push on device)
EXPO_PUBLIC_PROJECT_ID=2f34847e-ce67-4a47-ae0c-59255c70c787

# Optional path override for Android FCM config during EAS builds
# GOOGLE_SERVICES_JSON=./google-services.json
