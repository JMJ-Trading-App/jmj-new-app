# Leave unset to use platform defaults:
#   iOS simulator / web → http://localhost:3000/v1
#   Android emulator → http://10.0.2.2:3000/v1
# Physical device (same Wi‑Fi as your dev machine):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/v1
# Android emulator (host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/v1
# Production:
# EXPO_PUBLIC_API_URL=https://api.jmj.finance/v1
# After changing .env, restart Metro: npx expo start -c

# EAS project UUID (same as old JMJ app — required for Expo push on device)
EXPO_PUBLIC_PROJECT_ID=2f34847e-ce67-4a47-ae0c-59255c70c787

# Optional path override for Android FCM config during EAS builds
# GOOGLE_SERVICES_JSON=./google-services.json
