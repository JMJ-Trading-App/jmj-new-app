{
  "cli": {
    "version": ">= 18.0.4",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jmj.finance/v1"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jmj.finance/v1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jmj.finance/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6795306753"
      }
    }
  }
}
